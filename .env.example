PORT=3000

# Supabase (service_role — ห้ามใส่ใน frontend)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT — อย่างน้อย 32 ตัว สร้างด้วย:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# CORS: ใส่ domain ของ frontend คั่นด้วย , (เว้นว่าง = อนุญาตทุก origin)
CORS_ORIGINS=https://halloween.example.com,https://admin.halloween.example.com

# ช่วงเวลาเปิดหมุน (ISO 8601) — เว้นว่าง = เปิดตลอด
CAMPAIGN_START=2026-10-31T00:00:00+07:00
CAMPAIGN_END=2026-11-02T23:59:59+07:00

# ช่วงเวลาเปิดหมุนของ That Luang (ISO 8601) — เว้นว่าง = เปิดตลอด
THATLUANG_START=2026-11-09T00:00:00+07:00
THATLUANG_END=2026-11-29T23:59:59+07:00

# จำนวน reverse proxy หน้า app (Rancher ingress = 1) — local ไม่ต้องตั้ง
# TRUST_PROXY=1

# prefix ของ username ที่ระบบสร้างให้ผู้เล่น
PLAYER_USERNAME_PREFIX=hw2026_
