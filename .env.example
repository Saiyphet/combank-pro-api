# Supabase (service_role — ห้ามใส่ใน frontend)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT — อย่างน้อย 32 ตัว สร้างด้วย:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# CORS: ใส่ domain ของ frontend คั่นด้วย , (เว้นว่าง = อนุญาตทุก origin)
CORS_ORIGINS=https://halloween.example.com,https://admin.halloween.example.com

# ช่วงเวลาเปิดหมุน (ISO 8601) — เว้นว่าง = เปิดตลอด
# CAMPAIGN_START=2026-10-31T00:00:00+07:00
# CAMPAIGN_END=2026-11-02T23:59:59+07:00

# จำนวน reverse proxy หน้า app (Rancher ingress = 1) — local ไม่ต้องตั้ง
# TRUST_PROXY=1


# เข้ารหัส "รหัสที่ระบบออกให้" เพื่อให้ admin เปิดดูได้ (ข้อความสุ่มยาว ≥ 32 ตัว · ห้ามเปลี่ยนภายหลัง)
# สร้างค่า: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASSWORD_ENC_KEY=i9fosm7/8YVYptJYHliheVHo8rHuIfmV+fUFk8TsW6g=